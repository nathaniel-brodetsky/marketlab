# The shadow, as a systemd user service: copy to ~/.config/systemd/user/ with its .timer,
# then: systemctl --user daemon-reload && systemctl --user enable --now marketlab-shadow.timer
# (the repository is taken to be ~/projects/marketlab; name the hypotheses to record).
[Unit]
Description=marketlab shadow: what the hypotheses would hold after the daily close

[Service]
Type=oneshot
WorkingDirectory=%h/projects/marketlab
ExecStart=%h/projects/marketlab/scripts/shadow_daily.sh experiments/011-xsection-carry-forward.yaml experiments/015-xsection-carry-short.yaml experiments/017-trend-btc-eth-forward.yaml experiments/019-xsection-crowd-forward.yaml
